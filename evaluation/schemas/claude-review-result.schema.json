{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Claude PR Review Result",
  "type": "object",
  "required": [
    "findings"
  ],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding",
          "severity",
          "rule"
        ],
        "properties": {
          "finding": {
            "type": "boolean"
          },
          "severity": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW",
              "INFO",
              null
            ]
          },
          "rule": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}